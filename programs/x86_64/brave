#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=brave
CATALOG_FORMAT=2
CATALOG_RECIPE="x86_64/brave"
CATALOG_ALIAS="https://api.github.com/repos/ivan-hc/Brave-appimage/releases"

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*x86_64.*mage$"| grep -i "stable" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
