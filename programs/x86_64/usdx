#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=usdx
CATALOG_FORMAT=3
CATALOG_RECIPE="x86_64/usdx"
CATALOG_ALIAS="https://api.github.com/repos/UltraStar-Deluxe/USDX/releases"

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*mage$" | grep -vi "aarch64\|arm64\|armv7l\|i386\|i686" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
