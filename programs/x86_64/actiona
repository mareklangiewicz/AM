#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
# AM-RECIPE-DECLARATION 1
set -eu
APP=actiona
CATALOG_FORMAT=2
CATALOG_RECIPE=x86_64/actiona
CATALOG_ALIAS=https://api.github.com/repos/Jmgr/actiona/releases
CATALOG_REPOSITORY_ID=2405281
CATALOG_REPOSITORY=Jmgr/actiona
CATALOG_CHANNEL=any
CATALOG_ASSET_PATTERN='^actiona-[0-9]+([.][0-9]+)*-x86_64[.]AppImage$'
PACKAGE_KIND=appimage
PACKAGE_LAYOUT=raw
DESKTOP_EXEC=command
DESKTOP_STRIP_NO_SANDBOX=true

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
