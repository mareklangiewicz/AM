#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=headlamp
CATALOG_FORMAT=2
CATALOG_RECIPE="armv7l/headlamp"
CATALOG_ALIAS="https://api.github.com/repos/kubernetes-sigs/headlamp/releases"

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*mage$" | grep -vi "x86_64\|amd64\|aarch64\|arm64\|armv7l" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
