{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AM repository",
  "description": "Closed mapping-only AM contract; canonical order and cross-document semantics require the maintained readers.",
  "$ref": "#/$defs/repository",
  "$defs": {
    "inputs": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "policy": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "recipes": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "rules": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "schemas": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "source",
        "policy",
        "recipes",
        "rules",
        "schemas"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "id",
        "attempt"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "known",
            "unknown"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "enrolled": {
          "$ref": "#/$defs/measurement"
        },
        "selected": {
          "$ref": "#/$defs/measurement"
        },
        "attempted": {
          "$ref": "#/$defs/measurement"
        },
        "successful": {
          "$ref": "#/$defs/measurement"
        },
        "failed": {
          "$ref": "#/$defs/measurement"
        },
        "unknown": {
          "$ref": "#/$defs/measurement"
        },
        "unattempted": {
          "$ref": "#/$defs/measurement"
        },
        "deferred": {
          "$ref": "#/$defs/measurement"
        }
      },
      "required": [
        "enrolled",
        "selected",
        "attempted",
        "successful",
        "failed",
        "unknown",
        "unattempted",
        "deferred"
      ],
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "confirmed",
            "conflict",
            "failed",
            "unknown",
            "not_attempted"
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url_suffix": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^/\\s][^\\s]*$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "media_type": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "size"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "patternProperties": {
        "^[1-9][0-9]*$": {
          "$ref": "#/$defs/asset"
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "tag": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^/\\s][^\\s]*$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "published_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "prerelease": {
          "type": "boolean"
        },
        "source_zip_url": {
          "type": "string",
          "pattern": "^https://[^/\\s][^\\s]*$"
        },
        "source_tar_url": {
          "type": "string",
          "pattern": "^https://[^/\\s][^\\s]*$"
        },
        "download_base": {
          "type": "string",
          "pattern": "^https://[^/\\s][^\\s]*$"
        },
        "assets": {
          "$ref": "#/$defs/assets"
        }
      },
      "required": [
        "tag",
        "url",
        "prerelease",
        "assets"
      ],
      "additionalProperties": false
    },
    "releases": {
      "type": "object",
      "patternProperties": {
        "^[1-9][0-9]*$": {
          "$ref": "#/$defs/release"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "pages_fetched": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "history_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "page_size",
        "pages_fetched",
        "history_complete"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "pattern": "^programs/(x86_64|aarch64|i686|armv7l)/[a-z0-9][a-z0-9_.+-]{0,63}$"
        },
        "blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "repository",
        "commit",
        "path",
        "blob"
      ],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "commit",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9][a-z0-9_.+-]{0,63}$": {
          "$ref": "#/$defs/dependency"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "whole_wrapper",
            "whole_template",
            "reviewed_custom"
          ]
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "recipe_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rules": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dependencies": {
          "$ref": "#/$defs/dependencies"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "evaluated_at",
        "recipe_sha256",
        "rules",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "provenance_binding": {
      "type": "object",
      "properties": {
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "availability": {
          "type": "string",
          "enum": [
            "present",
            "absent",
            "unknown"
          ]
        },
        "classification": {
          "type": "string",
          "enum": [
            "shared",
            "template",
            "custom",
            "unknown"
          ]
        },
        "recipe": {
          "$ref": "#/$defs/binding"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "required": [
        "repository_id",
        "availability",
        "classification"
      ],
      "additionalProperties": false
    },
    "architectures": {
      "type": "object",
      "patternProperties": {
        "^(x86_64|aarch64|i686|armv7l)$": {
          "$ref": "#/$defs/provenance_binding"
        }
      },
      "additionalProperties": false
    },
    "provenance_apps": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9][a-z0-9_.+-]{0,63}$": {
          "$ref": "#/$defs/architectures"
        }
      },
      "additionalProperties": false
    },
    "run_references": {
      "type": "object",
      "patternProperties": {
        "^[1-9][0-9]*-[1-9][0-9]*$": {
          "type": "string",
          "pattern": "^runs/[1-9][0-9]*-[1-9][0-9]*/summary\\.yaml$"
        }
      },
      "additionalProperties": false
    },
    "detail_references": {
      "type": "object",
      "patternProperties": {
        "^[1-9][0-9]*-[1-9][0-9]*$": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "http_attempts": {
          "$ref": "#/$defs/measurement"
        },
        "charged_bytes": {
          "$ref": "#/$defs/measurement"
        },
        "received_bytes": {
          "$ref": "#/$defs/measurement"
        },
        "acquisition_milliseconds": {
          "$ref": "#/$defs/measurement"
        },
        "command_milliseconds": {
          "$ref": "#/$defs/measurement"
        },
        "tree_bytes": {
          "$ref": "#/$defs/measurement"
        },
        "largest_document_bytes": {
          "$ref": "#/$defs/measurement"
        },
        "local_object_bytes": {
          "$ref": "#/$defs/measurement"
        },
        "packed_history_bytes": {
          "$ref": "#/$defs/measurement"
        },
        "remote_storage_bytes": {
          "$ref": "#/$defs/measurement"
        },
        "peak_rss_bytes": {
          "$ref": "#/$defs/measurement"
        }
      },
      "required": [
        "http_attempts",
        "charged_bytes",
        "received_bytes",
        "acquisition_milliseconds",
        "command_milliseconds",
        "tree_bytes",
        "largest_document_bytes",
        "local_object_bytes",
        "packed_history_bytes",
        "remote_storage_bytes",
        "peak_rss_bytes"
      ],
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "acquisition_milliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "document_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "requests",
        "bytes",
        "acquisition_milliseconds",
        "document_bytes"
      ],
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "properties": {
        "catalog": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "under_24h": {
          "$ref": "#/$defs/measurement"
        },
        "from_24_to_48h": {
          "$ref": "#/$defs/measurement"
        },
        "at_least_48h": {
          "$ref": "#/$defs/measurement"
        },
        "no_success": {
          "$ref": "#/$defs/measurement"
        },
        "unknown": {
          "$ref": "#/$defs/measurement"
        }
      },
      "required": [
        "catalog",
        "evaluated_at",
        "under_24h",
        "from_24_to_48h",
        "at_least_48h",
        "no_success",
        "unknown"
      ],
      "additionalProperties": false
    },
    "daily": {
      "type": "object",
      "properties": {
        "reported_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "successful_sources": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "failed_sources": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "first_report": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "last_report": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      },
      "required": [
        "reported_attempts",
        "successful_sources",
        "failed_sources",
        "first_report",
        "last_report"
      ],
      "additionalProperties": false
    },
    "days": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}-[0-9]{2}-[0-9]{2}$": {
          "$ref": "#/$defs/daily"
        }
      },
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "properties": {
        "format": {
          "type": "integer",
          "const": 3
        },
        "schema": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/mareklangiewicz/AM/[0-9a-f]{40}/docs/catalog-format-v3\\.md$"
        },
        "kind": {
          "type": "string",
          "const": "catalog"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "producer": {
          "$ref": "#/$defs/run"
        },
        "retention": {
          "type": "string",
          "const": "32-plus-stable-exact-tag-v1"
        }
      },
      "required": [
        "format",
        "schema",
        "kind",
        "inputs",
        "producer",
        "retention"
      ],
      "additionalProperties": false
    },
    "app_paths": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9][a-z0-9_.+-]{0,63}$": {
          "type": "string",
          "pattern": "^repositories/[a-z0-9][a-z0-9_.+-]{0,63}\\.yaml$"
        }
      },
      "additionalProperties": false
    },
    "apps": {
      "type": "object",
      "properties": {
        "format": {
          "type": "integer",
          "const": 3
        },
        "schema": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/mareklangiewicz/AM/[0-9a-f]{40}/docs/catalog-format-v3\\.md$"
        },
        "kind": {
          "type": "string",
          "const": "apps"
        },
        "apps": {
          "$ref": "#/$defs/app_paths"
        }
      },
      "required": [
        "format",
        "schema",
        "kind",
        "apps"
      ],
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "properties": {
        "format": {
          "type": "integer",
          "const": 3
        },
        "schema": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/mareklangiewicz/AM/[0-9a-f]{40}/docs/catalog-format-v3\\.md$"
        },
        "kind": {
          "type": "string",
          "const": "repository"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "releases": {
          "$ref": "#/$defs/releases"
        }
      },
      "required": [
        "format",
        "schema",
        "kind",
        "repository_id",
        "repository",
        "collected_at",
        "scope",
        "observed_at",
        "releases"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "format": {
          "type": "integer",
          "const": 3
        },
        "schema": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/mareklangiewicz/AM/[0-9a-f]{40}/docs/catalog-format-v3\\.md$"
        },
        "kind": {
          "type": "string",
          "const": "provenance"
        },
        "apps": {
          "$ref": "#/$defs/provenance_apps"
        }
      },
      "required": [
        "format",
        "schema",
        "kind",
        "apps"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "schema": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/mareklangiewicz/AM/[0-9a-f]{40}/docs/catalog-status-v1\\.md$"
        },
        "kind": {
          "type": "string",
          "const": "status"
        },
        "schemas": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "last_report": {
          "type": "string",
          "pattern": "^runs/[1-9][0-9]*-[1-9][0-9]*/summary\\.yaml$"
        },
        "reported_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "last_confirmed_publication": {
          "$ref": "#/$defs/publication"
        },
        "summaries": {
          "$ref": "#/$defs/run_references"
        },
        "details": {
          "$ref": "#/$defs/detail_references"
        }
      },
      "required": [
        "format",
        "schema",
        "kind",
        "schemas",
        "last_report",
        "reported_at",
        "last_confirmed_publication",
        "summaries",
        "details"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "schema": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/mareklangiewicz/AM/[0-9a-f]{40}/docs/catalog-status-v1\\.md$"
        },
        "kind": {
          "type": "string",
          "const": "summary"
        },
        "run": {
          "$ref": "#/$defs/run"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "input_catalog": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "reported_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "collection": {
          "type": "string",
          "enum": [
            "ok",
            "partial",
            "failed",
            "unknown",
            "not_attempted"
          ]
        },
        "validation": {
          "type": "string",
          "enum": [
            "ok",
            "partial",
            "failed",
            "unknown",
            "not_attempted"
          ]
        },
        "publication": {
          "$ref": "#/$defs/publication"
        },
        "compatibility_publication": {
          "$ref": "#/$defs/publication"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "stop_reason": {
          "type": "string",
          "enum": [
            "transport",
            "authentication",
