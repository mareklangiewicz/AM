#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=muon-pdf
CATALOG_FORMAT=2
CATALOG_RECIPE="aarch64/muon-pdf"
CATALOG_ALIAS="https://api.github.com/repos/Boteium/muon-pdf/releases"

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*mage$" | grep -vi "x86_64\|amd64\|armv7l\|i386\|i686" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
