# AM-RECIPE-DECLARATION 1
set -eu
APP=ace-gui
CATALOG_FORMAT=2
CATALOG_RECIPE=x86_64/ace-gui
CATALOG_ALIAS=https://api.github.com/repos/daisy/ace-gui/releases
CATALOG_REPOSITORY_ID=134057106
CATALOG_REPOSITORY=daisy/ace-gui
CATALOG_CHANNEL=any
CATALOG_ASSET_PATTERN='^Ace[.]by[.]DAISY-[0-9]+([.][0-9]+)*[.]AppImage$'
