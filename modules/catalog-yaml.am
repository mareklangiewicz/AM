#!/bin/sh
# AMCLI catalog acquisition and selection: raw main-marek/catalog/ files
# (docs/catalog-format.md), no pins. No Git/Python/jq on clients.
# Named policies are proposed, not rollout acceptance. Old data warns, never refuses.
set -eu
export LC_ALL=C
fail() { printf 'AM YAML catalog: %s\n' "$*" >&2; exit 1; }
[ "$#" -gt 0 ] || fail 'missing recipe'
AM_YAML_RECIPE=$1; shift
app=${AM_YAML_RECIPE#*/}
AM_YAML_TOOL='' AM_YAML_INCLUDE_PUBLICATION='' AM_YAML_SOURCE_REPOSITORY='' url_only=false
AM_YAML_OUTPUT='' AM_YAML_LIST_URLS='' AM_YAML_URL_FILTER='' AM_YAML_URL_PATTERN='' AM_YAML_URL_CONTAINS='' AM_YAML_SELECTED_URL='' version_url=false
while [ "$#" -gt 0 ]; do
    case $1 in
        --tool) [ "$#" -ge 2 ] && [ -z "$AM_YAML_TOOL" ] || fail 'missing or repeated tool'; AM_YAML_TOOL=$2; shift 2 ;;
        --with-published-at) AM_YAML_INCLUDE_PUBLICATION=1; shift ;;
        --url) [ "$url_only" = false ] || fail 'repeated URL option'; url_only=true; shift ;;
        --version-url) [ "$version_url" = false ] || fail 'repeated version URL option'; version_url=true; url_only=true; shift ;;
        --urls) [ -z "$AM_YAML_LIST_URLS" ] || fail 'repeated URL list'; AM_YAML_LIST_URLS=1; shift ;;
        --tag|--published-at|--release-url|--release-id|--source-tar-url|--source-zip-url|--asset-id|--git-commit|--git-file|--git-snapshot)
            [ -z "$AM_YAML_OUTPUT" ] || fail 'repeated output field'; AM_YAML_OUTPUT=${1#--}; shift ;;
        --url-filter)
            [ "$#" -ge 3 ] && [ -z "$AM_YAML_URL_FILTER" ] || fail 'missing or repeated URL filter'
            case $2 in i|vi) ;; *) fail 'unsupported URL filter mode';; esac
            [ "${#3}" -le 1024 ] || fail 'URL filter bound'
            AM_YAML_URL_FILTER=$2 AM_YAML_URL_PATTERN=$3; shift 3 ;;
        --url-contains)
            [ "$#" -ge 2 ] && [ -z "$AM_YAML_URL_CONTAINS" ] || fail 'missing or repeated URL substring'
            AM_YAML_URL_CONTAINS=$2; shift 2 ;;
        --selected-url)
            [ "$#" -ge 2 ] && [ -z "$AM_YAML_SELECTED_URL" ] || fail 'missing or repeated selected URL'
            AM_YAML_SELECTED_URL=$2; shift 2 ;;
        --source-repository)
            [ "$#" -ge 2 ] && [ -z "$AM_YAML_SOURCE_REPOSITORY" ] || fail 'missing or repeated recipe source'
            AM_YAML_SOURCE_REPOSITORY=$2; shift 2 ;;
        --commit|--updated-at) fail "unsupported option: $1 (the catalog has no commit pins or update times)" ;;
        *) fail 'unsupported option (format-1 consent does not apply)' ;;
    esac
done
source=${AMREPO-}
case $source in *[!A-Za-z0-9_./:-]*) fail 'unsupported AMREPO characters';; esac
printf '%s\n' "$source" | grep -Eq '^https://raw\.githubusercontent\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+$' || fail 'missing or unsupported AMREPO'
repository=${source#https://raw.githubusercontent.com/}
owner=${repository%%/*}; repository=${repository#*/}; repository=$owner/${repository%%/*}
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
reader=$here/catalog-reader.am
for module in catalog-reader.am catalog-parser.am catalog-tables.am catalog-yaml-policy.am; do
    [ -r "$here/$module" ] || fail "missing module: $module"
done
# Validate against trusted selection declarations/policies before HTTP.
# Collection enrollment is a separate publication choice.
policy_info=$(AM_YAML_RECIPE=$AM_YAML_RECIPE AM_YAML_SOURCE_REPOSITORY=$AM_YAML_SOURCE_REPOSITORY AM_YAML_CHECK_RECIPE=1 AM_YAML_APP_NAME=1 AM_YAML_POLICY_INFO=1 \
    awk -f "$here/catalog-yaml-policy.am" </dev/null) || fail 'unsupported recipe policy'
app=$(printf '%s\n' "$policy_info" | sed -n '1p')
selection=$(printf '%s\n' "$policy_info" | sed -n '2p')
printf '%s\n' "$app" | grep -Eq '^[a-z0-9][a-z0-9_.+-]{0,63}$' || fail 'invalid catalog app identity'
case $selection:$AM_YAML_OUTPUT in
    asset:|asset:tag|asset:published-at|asset:asset-id|release:tag|release:published-at|release:release-url|release:release-id|release:source-tar-url|release:source-zip-url|git-tag:tag|git-branch:git-commit|git-file:git-commit|git-file:git-file|git-file:git-snapshot) ;;
    *) fail 'unsupported policy output field';;
esac
if [ "$selection" != asset ]; then
    [ "$url_only" = false ] && [ -z "$AM_YAML_LIST_URLS$AM_YAML_URL_FILTER$AM_YAML_URL_CONTAINS$AM_YAML_SELECTED_URL" ] || fail 'asset options require an asset policy'
fi
[ "$url_only" = false ] || [ -z "$AM_YAML_OUTPUT$AM_YAML_LIST_URLS" ] || fail 'conflicting output options'
# Fixed trial budgets shared with the source candidate. No optional consumer workers.
AM_YAML_MAX_INPUT_BYTES=2097152 AM_YAML_MAX_OUTPUT_BYTES=2097152
export AM_YAML_MAX_INPUT_BYTES AM_YAML_MAX_OUTPUT_BYTES
clock() {
    stamp=$(date -u '+%s %Y-%m-%dT%H:%M:%SZ') || fail 'UTC clock unavailable'
    now_epoch=${stamp%% *}; AM_YAML_NOW=${stamp#* }
    case $now_epoch in ''|*[!0-9]*) fail 'invalid clock';; esac
    [ "${#now_epoch}" -le 12 ] || fail 'invalid clock'
}
clock
start=$now_epoch last=$now_epoch
check_clock() {
    clock
    [ "$now_epoch" -ge "$last" ] && [ "$((now_epoch - start))" -le 90 ] || fail 'regressed clock or expired read'
    last=$now_epoch
}
umask 077
scratch=$(mktemp -d) || fail 'private staging unavailable'
trap 'rm -rf -- "$scratch"' 0
trap 'exit 1' HUP INT TERM
# A command session caches each catalog file once, so every selection in one
# command reads the same bytes (a package's tools come from one release).
session=${AM_CATALOG_SESSION-}
if [ -n "$session" ]; then
    [ -d "$session" ] && [ -w "$session" ] && [ ! -L "$session" ] || fail 'invalid command session'
    cache=$session/yaml-catalog
    if [ -d "$cache" ]; then
        [ "$(cat "$cache/source")" = "$source" ] || fail 'command source changed'
        [ ! -f "$cache/failed" ] || fail 'command catalog acquisition already refused'
    else
        mkdir "$cache"
        printf '%s\n' "$source" > "$cache/source"
    fi
else
    cache=$scratch/cache
    mkdir "$cache"
fi
root=https://raw.githubusercontent.com/$repository/main-marek/catalog
# The transport contract: no config, auth, proxy or redirects. Raw files of
# one branch can lag each other briefly behind GitHub's CDN, so a missing file
# is retried a few times before the command gives up.
acquire() {
    name=$1 target=$cache/$1
    if [ ! -f "$target" ]; then
        # Any transfer/validation failure latches the command.
        : > "$cache/failed"
        tries=0
        while :; do
            tries=$((tries + 1))
            code=$(
                ulimit -f "$(( (2097152 + 511) / 512 ))" || exit 1
                curl -q --silent --show-error --noproxy '*' --proto '=https' \
                    --max-redirs 0 --connect-timeout 10 --max-time 30 --max-filesize 2097152 \
                    -H 'Accept-Encoding: identity' -H 'Accept: application/octet-stream' \
                    --output "$scratch/document" --write-out '%{http_code}' "$root/$name"
            ) || fail 'catalog transfer refused'
            [ "$code" = 404 ] && [ "$tries" -lt 3 ] || break
            sleep 2
        done
        [ "$code" = 200 ] && [ "$(wc -c < "$scratch/document")" -le 2097152 ] || fail 'catalog response refused'
        check_clock
        sh "$reader" validate "$scratch/document" || fail 'invalid YAML document'
        mkdir -p "$(dirname "$target")"
        cp "$scratch/document" "$target"
        rm -f "$cache/failed"
    fi
}
acquire apps.yaml
[ "$(sh "$reader" kind "$cache/apps.yaml")" = apps ] || fail 'apps.yaml is not an apps document'
# Revalidate cached bytes before each selection; never cache acceptance.
source_path=$(sh "$reader" get "$cache/apps.yaml" apps "$app" repository) || fail 'unknown app or invalid app map'
printf '%s\n' "$source_path" | grep -Eq '^repositories/[a-z0-9][a-z0-9_.+-]{0,63}[.]yaml$' || fail 'invalid source path'
acquire "$source_path"
file=$cache/$source_path
[ "$(sh "$reader" kind "$file")" = repository ] || fail "$source_path is not a repository document"
AM_YAML_REPOSITORY=$(sh "$reader" get "$file" repository_id) || fail 'invalid repository document'
case $AM_YAML_REPOSITORY in ''|*[!0-9]*) fail 'invalid repository ID';; esac
case $selection in asset) operation=asset_facts;; release) operation=release_facts;; git-*) operation=git_facts;; esac
sh "$reader" "$operation" "$file" > "$scratch/facts" || fail 'invalid repository facts'
check_clock
export AM_YAML_RECIPE AM_YAML_REPOSITORY AM_YAML_NOW AM_YAML_TOOL AM_YAML_INCLUDE_PUBLICATION AM_YAML_SOURCE_REPOSITORY
export AM_YAML_OUTPUT AM_YAML_LIST_URLS AM_YAML_URL_FILTER AM_YAML_URL_PATTERN AM_YAML_URL_CONTAINS AM_YAML_SELECTED_URL
if [ "$version_url" = true ]; then
    [ -z "$AM_YAML_SELECTED_URL" ] || fail 'conflicting selected URL'
    AM_YAML_LIST_URLS=1 awk -f "$here/catalog-yaml-policy.am" "$scratch/facts" > "$scratch/urls" || exit 1
    AM_YAML_SELECTED_URL=$(sort -V "$scratch/urls" | tail -1)
    [ -n "$AM_YAML_SELECTED_URL" ] || fail 'no matching version URL'
    export AM_YAML_SELECTED_URL
fi
awk -f "$here/catalog-yaml-policy.am" "$scratch/facts" > "$scratch/result" || exit 1
check_clock
# Recheck the same selected facts at the final clock before output.
export AM_YAML_NOW
AM_YAML_WARNING=$scratch/warning awk -f "$here/catalog-yaml-policy.am" "$scratch/facts" > "$scratch/result" || exit 1
# Once per app per command: the cache is the command session's when there is one.
if [ -s "$scratch/warning" ] && [ ! -e "$cache/warned-$app" ]; then
    : > "$cache/warned-$app"
    IFS='	' read -r days observed < "$scratch/warning"
    printf 'AM YAML catalog: warning: %s catalog data last seen %s days ago (%s); using it anyway\n' "$app" "$days" "$observed" >&2
fi
if [ "$AM_YAML_LIST_URLS" = 1 ]; then sort -u "$scratch/result"
elif [ "$url_only" = true ]; then sed -n '5p' "$scratch/result"
else cat "$scratch/result"
fi
