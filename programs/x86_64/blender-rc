#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=blender-rc
CATALOG_FORMAT=3
CATALOG_RECIPE="x86_64/blender-rc"
CATALOG_ALIAS="https://api.github.com/repos/ivan-hc/Blender-appimage/releases?per_page=100"
CATALOG_APPIMAGE_ENDPOINT=list
CATALOG_REPOSITORY_ID=980873950
CATALOG_CHANNEL=any
CATALOG_URL_RULES='[{"pattern":"https.*mage$","ignore_case":true,"exclude":false},{"pattern":"i386|i686|aarch64|arm64|armv7l","ignore_case":true,"exclude":true},{"pattern":"candidate","ignore_case":true,"exclude":false}]'

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*mage$" | grep -vi "i386\|i686\|aarch64\|arm64\|armv7l" | grep -i "candidate" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
