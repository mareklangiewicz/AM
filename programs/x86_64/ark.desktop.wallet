#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
# AM-RECIPE-DECLARATION 1
set -eu
APP=ark.desktop.wallet
CATALOG_ALIAS=https://api.github.com/repos/ArkEcosystem/desktop-wallet/releases
CATALOG_FORMAT=3
CATALOG_RECIPE=x86_64/ark.desktop.wallet
CATALOG_REPOSITORY_ID=73618120
CATALOG_REPOSITORY=ArkEcosystem/desktop-wallet
CATALOG_CHANNEL=any
CATALOG_ASSET_PATTERN='^.*$'
CATALOG_URL_RULES='[{"pattern":"https.*mage$","ignore_case":true,"exclude":false},{"pattern":"i386|i686|aarch64|arm64|armv7l","ignore_case":true,"exclude":true}]'

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
