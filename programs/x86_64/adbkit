set -eu
APP=adbkit
CATALOG_FORMAT=3
CATALOG_RECIPE=x86_64/adbkit
CATALOG_ALIAS=https://api.github.com/repos/drenzzz/adbkit/releases
CATALOG_REPOSITORY_ID=1089623281
