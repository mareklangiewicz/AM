#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=nvim
CATALOG_ALIAS="https://api.github.com/repos/neovim/neovim/releases"
select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -o 'https.*releases.*nvim.*mage$' | grep -v "nightly\|arm64\|aarch64\|i686\|i386" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
