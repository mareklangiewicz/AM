#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
# AM-RECIPE-DECLARATION 1
set -eu
APP=agent-pulse
CATALOG_FORMAT=3
CATALOG_RECIPE=x86_64/agent-pulse
CATALOG_ALIAS=https://api.github.com/repos/dipen-dedania/agent-pulse/releases
CATALOG_REPOSITORY_ID=1211202862
CATALOG_REPOSITORY=Dipen-Dedania/agent-pulse
CATALOG_CHANNEL=any
CATALOG_ASSET_PATTERN='^Agent[.]Pulse-[0-9]+([.][0-9]+)*[.]AppImage$'
PACKAGE_KIND=appimage
PACKAGE_LAYOUT=raw
DESKTOP_EXEC=command
DESKTOP_STRIP_NO_SANDBOX=true

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
