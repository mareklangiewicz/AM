#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=install
PACKAGE_KIND=executable
CATALOG_FORMAT=3
CATALOG_RECIPE="aarch64/install"
CATALOG_ALIAS="https://api.github.com/repos/ivan-hc/am-utils/releases"

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -Eoi "https.*download.*/aarch64-[0-9]{8}/${APP}_.*-aarch64-static$" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_package "$0" "$@"
