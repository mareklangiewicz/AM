#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=opera-beta
CATALOG_FORMAT=3
CATALOG_RECIPE="x86_64/opera-beta"
CATALOG_ALIAS="https://api.github.com/repos/ivan-hc/Opera-appimage/releases"

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*beta.*mage$" | grep -vi "i386\|i686\|aarch64\|arm64\|armv7l" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
