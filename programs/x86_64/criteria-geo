# AM-CATALOG-RECIPE 1
set -eu
APP=criteria-geo
CATALOG_FORMAT=2
CATALOG_RECIPE="x86_64/criteria-geo"
CATALOG_ALIAS="https://api.github.com/repos/ARPA-SIMC/CRITERIA1D/releases"

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*mage$" | grep -vi "i386\|i686\|aarch64\|arm64\|armv7l" | grep -i "geo" | head -1
}

