    if(image_policy==40) return (lower ~ "https.*mage$" && lower ~ "stable")
    if(image_policy==41) return (lower ~ "https.*mage$" && lower ~ "beta")
    if(image_policy==42) return (lower ~ "https.*mage$" && lower ~ "corporate")
    if(image_policy==43) return (lower ~ "https.*mage$" && lower !~ "x86_64|amd64|armv7l|i386|i686")
    if(image_policy==44) return (lower ~ "https.*download.*mage$" && lower ~ "aarch64|arm64")
    if(image_policy==45) return (lower ~ "https.*aarch64.*mage$" && lower ~ "stable")
    if(image_policy==46) return (lower ~ "https.*aarch64.*mage$" && lower ~ "beta")
    if(image_policy==47) return (lower ~ "https.*aarch64.*mage$" && lower ~ "nightly")
    if(image_policy==48) return (lower ~ "https.*aarch64.*mage$")
    if(image_policy==49) return (lower ~ "https.*aarch64.*mage$" && url ~ "DEV")
    if(image_policy==50) return (lower ~ "https.*snapshot.*aarch64.*mage$")
    if(image_policy==51) return (lower ~ "https.*stable.*aarch64.*mage$")
    if(image_policy==52) return (lower ~ "https.*i686.*mage$")
    if(image_policy==53) return (lower ~ "https.*i686.*mage$" && url ~ "DEV")
    if(image_policy==54) return (lower ~ "https.*mage$" && lower !~ "x86_64|amd64|aarch64|arm64|armv7l")
    return 0
}
# END explicit AppImage policies
# BEGIN single-user policies
