    if(path==query && operation=="get" && key!="observed_at" && key!="media_type" && key!="content_type" && key!="url") {
        if(kind=="map" || kind=="empty") fail("scalar query")
        found=1; emit(value)
    }
    if((operation=="apps" && p=="/apps") || (operation=="releases" && p=="/releases") || (operation=="assets" && p==query)) { found=1; emit(key "\n") }
    if(path==query && (kind=="map" || kind=="empty")) found=1
}
END {
    if(invalid) exit 2
    for(p in node_type) check_node(p)
    if(NR<3) fail("header")
    if(values["/format"]!=rule_const[root_kind "/format"] || types["/format"]!="integer" || types["/schema"]!="string" || values["/schema"] !~ rule_pattern[root_kind "/schema"]) fail("version/schema")
    semantics()
    if(operation=="get" && !found && query in types) { found=1; emit(values[query]) }
    if(operation=="get") for(p in virtual_url) if(query==p "/url" && !(query in types)) { found=1; emit(virtual_url[p]) }
    if((operation=="asset_facts" || operation=="release_facts" || operation=="git_facts") && values["/kind"]!="repository") fail("repository facts required")
    if(operation=="asset_facts") for(i=1;i<=asset_count;i++) emit(fact_rows[asset_paths[i]])
    if(operation=="release_facts" || operation=="git_facts") project_facts()
    if(operation=="validate" || operation=="asset_facts" || operation=="release_facts" || operation=="git_facts") exit 0
    if(!found) exit 3
}
