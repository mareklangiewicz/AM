gital Radio, decoding\r\n\r\nAs usual, a windows installer and an AppImage are part of the distribution\r\n"},{"url":"https://api.github.com/repos/JvanKatwijk/swradio-8/releases/67725262","assets_url":"https://api.github.com/repos/JvanKatwijk/swradio-8/releases/67725262/assets","upload_url":"https://uploads.github.com/repos/JvanKatwijk/swradio-8/releases/67725262/assets{?name,label}","html_url":"https://github.com/JvanKatwijk/swradio-8/releases/tag/v9","id":67725262,"author":{"login":"JvanKatwijk","id":8713152,"node_id":"MDQ6VXNlcjg3MTMxNTI=","avatar_url":"https://avatars.githubusercontent.com/u/8713152?v=4","gravatar_id":"","url":"https://api.github.com/users/JvanKatwijk","html_url":"https://github.com/JvanKatwijk","followers_url":"https://api.github.com/users/JvanKatwijk/followers","following_url":"https://api.github.com/users/JvanKatwijk/following{/other_user}","gists_url":"https://api.github.com/users/JvanKatwijk/gists{/gist_id}","starred_url":"https://api.github.com/users/JvanKatwijk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JvanKatwijk/subscriptions","organizations_url":"https://api.github.com/users/JvanKatwijk/orgs","repos_url":"https://api.github.com/users/JvanKatwijk/repos","events_url":"https://api.github.com/users/JvanKatwijk/events{/privacy}","received_events_url":"https://api.github.com/users/JvanKatwijk/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOB0jAQs4ECWfO","tag_name":"v9","target_commitish":"master","name":"swradio-9","draft":false,"immutable":false,"prerelease":false,"created_at":"2022-05-24T18:21:30Z","updated_at":"2022-05-24T18:36:24Z","published_at":"2022-05-24T18:36:24Z","assets":[{"url":"https://api.github.com/repos/JvanKatwijk/swradio-8/releases/assets/66504896","id":66504896,"node_id":"RA_kwDOB0jAQs4D9sjA","name":"setup-swradio.exe","label":null,"uploader":{"login":"JvanKatwijk","id":8713152,"node_id":"MDQ6VXNlcjg3MTMxNTI=","avatar_url":"https://avatars.githu