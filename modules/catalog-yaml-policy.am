# Maintained selection logic; generated declarations above contain data only.
function declaration_recipe(recipe) {
    if(!(recipe in recipes_repository)) return 0
    declaration_repository=recipes_repository[recipe]
    declaration_channel=recipes_channel[recipe]
    declaration_pattern=recipes_pattern[recipe]
    declaration_tools=recipes_tools[recipe]
    declaration_tool_suffix=recipes_tool_suffix[recipe]
    declaration_fresh_only=recipes_fresh_only[recipe]
    return 1
}
function declaration_eligible(name, tag, preview, tool, lower) {
    if(declaration_channel=="stable" && (preview!="false" || tag=="nightly")) return 0
    if(declaration_channel=="nightly" && tag!="nightly") return 0
    lower=tolower(name)
    if(lower ~ /macos|darwin|windows/) return 0
    # armhf alone does not establish ARMv7; only an explicit armv7 label
    # admits that target. Reject armhf-labelled names on the other targets.
    if(arch=="x86_64" && lower ~ /aarch64|arm64|armhf|armv7|i386|i686/) return 0
    if(arch=="aarch64" && (lower !~ /aarch64|arm64/ || lower ~ /x86_64|amd64|armhf|armv7|i386|i686/)) return 0
    if(arch=="i686" && (lower !~ /i386|i686/ || lower ~ /x86_64|amd64|aarch64|arm64|armhf|armv7/)) return 0
    if(arch=="armv7l" && (lower !~ /armv7/ || lower ~ /x86_64|amd64|aarch64|arm64|i386|i686/)) return 0
    if(declaration_tools!="") {
        tool=ENVIRON["AM_YAML_TOOL"]; split(declaration_tools,tools," "); if(tool=="") tool=tools[1]
        if(index(" " declaration_tools " "," " tool " ")==0) return 0
        return name==tool declaration_tool_suffix
    }
    return name ~ declaration_pattern
}
BEGIN {
    recipe=ENVIRON["AM_YAML_RECIPE"]; split(recipe,r,"/"); arch=r[1]; app=r[2]
    declared=declaration_recipe(recipe)
    utility=am_utils_recipe(recipe)
    image=appimage_recipe(recipe)
    known=(declared || utility || image || recipe=="x86_64/obsidian" || recipe=="x86_64/nvim" ||
           recipe=="aarch64/nvim" || recipe=="x86_64/nvim-nightly" || recipe=="aarch64/nvim-nightly")
    if(!known) refuse("unsupported_recipe_policy")
    check_only=(ENVIRON["AM_YAML_CHECK_RECIPE"]=="1")
    if(declaration_fresh_only && ENVIRON["AM_YAML_ACCEPT"]!="") refuse("toolset requires fresh observations; refresh the catalog")
    if(check_only) exit
    if(!timestamp(ENVIRON["AM_YAML_NOW"])) refuse("utc_now_required")
    if(declared && ENVIRON["AM_YAML_REPOSITORY"]!=declaration_repository) refuse("declaration_repository_mismatch")
    if(!declared && utility && ENVIRON["AM_YAML_REPOSITORY"]!="1225768109") refuse("am_utils_repository_mismatch")
    if(!declared && image && ENVIRON["AM_YAML_REPOSITORY"]!=image_repository) refuse("appimage_repository_mismatch")
    FS="\t"
}

{
    release_id=$1; asset_id=$2; observed=decode($3); published=decode($4)
    tag=decode($5); name=decode($6); url=decode($7)
    if(declared) {
        eligible=declaration_eligible(name,tag,$8)
    } else if(image) {
        eligible=appimage_eligible(url)
        if(image_stable && $8!="false") eligible=0
    } else if(utility) {
        # Match the literal URL component, including the reviewed encoded pluses.
        # ld.bfd's dot is literal here, unlike the old interpolated ERE wildcard.
        component=(app=="c++filt" ? "c%2b%2bfilt" : app)
        u=tolower(url)
        gsub(/[.]/,"[.]",component)
        # Match the entire expression: a greedy prefix-only match can skip an
        # earlier eligible component when the URL has repeated dated paths.
        pattern="https.*download.*/" arch "-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]/" component "_.*-" arch "-static$"
        eligible=(u ~ pattern)
    } else if(app=="obsidian") {
        u=tolower(url)
        eligible=(u ~ /https.*mage$/ && u !~ /i386|i686|aarch64|arm64|armv7l/)
    } else {
        eligible=(url ~ /https.*releases.*nvim.*mage$/)
        if(arch=="x86_64" && url ~ /arm64|aarch64|i686|i386/) eligible=0
        if(arch=="aarch64" && url ~ /x86_64|i686|i386/) eligible=0
        if(app=="nvim-nightly") { if(tag!="nightly" || index(tolower(url),"nightly")==0) eligible=0 }
        else if(tag=="nightly" || index(url,"nightly")!=0) eligible=0
    }
    if(!eligible) next
    better=(!chosen || published>best_published || (published==best_published && less(best_release,release_id)))
    if(chosen && "x" release_id=="x" best_release)
        better=("x" name<"x" best_name || ("x" name=="x" best_name && less(asset_id,best_asset)))
    if(better) {
        chosen=1; best_release=release_id; best_asset=asset_id; best_published=published
        best_name=name; best_url=url; best_observed=observed
    }
}
END {
    if(failed) exit 3
    if(check_only) exit 0
    if(!chosen) refuse("no_matching_asset")
    age=seconds(ENVIRON["AM_YAML_NOW"])-seconds(best_observed)
    token=ENVIRON["AM_YAML_PIN"] ":" ENVIRON["AM_YAML_REPOSITORY"] ":" best_release ":" best_asset ":" best_observed
    if(age<0) refuse("future_release_observation")
    if(age>172800 && ENVIRON["AM_YAML_ACCEPT"]!=token) {
        if(ENVIRON["AM_YAML_STALE_OPTION"]=="release")
            refuse("stale; retry with --commit " ENVIRON["AM_YAML_PIN"] " --accept-stale-release " ENVIRON["AM_YAML_PIN"] " " ENVIRON["AM_YAML_REPOSITORY"] " " best_release " " best_asset " " best_observed)
        refuse("stale_release_acceptance_required " token)
    }
    # Fixed line protocol: no eval or shell interpretation; URL has no whitespace.
    print ENVIRON["AM_YAML_PIN"]
    print ENVIRON["AM_YAML_REPOSITORY"]
    print best_release
    print best_asset
    print best_observed
    print best_url
    if(ENVIRON["AM_YAML_INCLUDE_PUBLICATION"]=="1") print best_published
}
