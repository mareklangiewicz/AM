#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
# AM-RECIPE-DECLARATION 1
set -eu
APP=agent-launcher
CATALOG_FORMAT=2
CATALOG_RECIPE=x86_64/agent-launcher
CATALOG_ALIAS=https://api.github.com/repos/agent-launch/agent-launcher/releases
CATALOG_REPOSITORY_ID=1364985464
CATALOG_REPOSITORY=agent-launch/agent-launcher
CATALOG_CHANNEL=any
CATALOG_ASSET_PATTERN='^AgentLauncher-[0-9]+([.][0-9]+)*-linux-x86_64[.]AppImage$'
PACKAGE_KIND=appimage
PACKAGE_LAYOUT=raw
DESKTOP_EXEC=command
DESKTOP_STRIP_NO_SANDBOX=true

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
