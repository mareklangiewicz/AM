#!/usr/bin/env bash
# AM-CATALOG-RECIPE 1
CATALOG_FORMAT=3
AMREPO=${AMREPO-}
export AMREPO
if [ -z "${AM_CATALOG_SESSION-}" ]; then
    AM_CATALOG_SESSION=$(mktemp -d) || exit 1
    export AM_CATALOG_SESSION
    trap 'rm -rf -- "$AM_CATALOG_SESSION"' 0
    trap 'exit 1' HUP INT TERM
fi

# AM INSTALL SCRIPT VERSION 3.5
set -u
APP=wine
SITE="mmtrt/WINE_AppImage"

# CREATE DIRECTORIES AND ADD REMOVER
[ -n "$APP" ] && mkdir -p "/opt/$APP/tmp" "/opt/$APP/icons" && cd "/opt/$APP/tmp" || exit 1
printf "#!/bin/sh\nset -e\nrm -f /usr/local/bin/$APP /usr/local/bin/wine64\nrm -R -f /opt/$APP" > ../remove
printf '\n%s' "rm -f /usr/local/share/applications/$APP-AM.desktop" >> ../remove
chmod a+x ../remove || exit 1

# DOWNLOAD AND PREPARE THE APP, $version is also used for updates
wine_args=$(sh "/opt/am/modules/catalog-yaml.am" x86_64/wine --urls "$@") || exit 1
printf "Select a URL from this menu (read carefully) or any other key to abort:\n-----------------------------------------------------------------------\n"; sleep 1
	select version in $wine_args; do [ -n "$version" ] && break || echo ">>> Invalid Selection, aborted!" && exit 0
done
version=$(sh "/opt/am/modules/catalog-yaml.am" x86_64/wine --url --selected-url "$version" "$@") || exit 1
wget "$version" || exit 1
cd ..
mv ./tmp/*mage ./"$APP"
rm -R -f ./tmp || exit 1
echo "$version" > ./version
chmod a+x ./"$APP" || exit 1

# LINK TO PATH
ln -s "/opt/$APP/$APP" "/usr/local/bin/$APP"; ln -s "/usr/local/bin/$APP" "/usr/local/bin/wine64"

# SCRIPT TO UPDATE THE PROGRAM
cat >> ./AM-updater << 'EOF'
#!/bin/sh
# AM-CATALOG-RECIPE 1
CATALOG_FORMAT=3
AMREPO=${AMREPO-}
export AMREPO
if [ -z "${AM_CATALOG_SESSION-}" ]; then
    AM_CATALOG_SESSION=$(mktemp -d) || exit 1
    export AM_CATALOG_SESSION
    trap 'rm -rf -- "$AM_CATALOG_SESSION"' 0
    trap 'exit 1' HUP INT TERM
fi
set -u
APP=wine
SITE="mmtrt/WINE_AppImage"
version0=$(cat "/opt/$APP/version"); tag=$(echo "$version0" | tr '/' '\n' | tail -2 | head -1)
version=$(sh "/opt/am/modules/catalog-yaml.am" x86_64/wine --url --url-contains "/download/$tag/" "$@") || exit 1
[ -n "$version" ] || { echo "Error getting link"; exit 1; }
if [ "$version" != "$version0" ]; then
	mkdir "/opt/$APP/tmp" && cd "/opt/$APP/tmp" || exit 1
	notify-send "A new version of $APP is available, please wait"
	wget "$version" || exit 1
	# Use tar fx ./*tar* here for example in this line in case a compressed file is downloaded.
	cd ..
	mv --backup=t ./tmp/*mage ./"$APP"
	chmod a+x ./"$APP" || exit 1
	echo "$version" > ./version
	rm -R -f ./*zs-old ./*.part ./tmp ./*~
	notify-send "$APP is updated!"
else
	echo "Update not needed!"
fi
EOF
chmod a+x ./AM-updater || exit 1
