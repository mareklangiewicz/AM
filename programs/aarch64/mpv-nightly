#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=mpv-nightly
CATALOG_ALIAS="https://api.github.com/repos/pkgforge-dev/mpv-AppImage/releases"

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*download.*mage$" |  grep -i "aarch64\|arm64" | grep -i "Nightly" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
