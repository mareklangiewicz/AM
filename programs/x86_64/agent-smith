set -eu
APP=agent-smith
CATALOG_FORMAT=2
CATALOG_RECIPE=x86_64/agent-smith
CATALOG_ALIAS=https://api.github.com/repos/ghostwrk/agent-smith/releases
CATALOG_REPOSITORY_ID=1279766252
