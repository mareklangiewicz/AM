#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
# AM-RECIPE-DECLARATION 1
set -eu
APP=agent-arcade
CATALOG_FORMAT=3
CATALOG_RECIPE=x86_64/agent-arcade
CATALOG_ALIAS=https://api.github.com/repos/danwahlin/agent-arcade/releases
CATALOG_REPOSITORY_ID=1213992071
CATALOG_REPOSITORY=DanWahlin/agent-arcade
CATALOG_CHANNEL=any
CATALOG_ASSET_PATTERN='^Agent[.]Arcade_[0-9]+([.][0-9]+)*_amd64[.]AppImage$'
PACKAGE_KIND=appimage
PACKAGE_LAYOUT=raw
DESKTOP_EXEC=command
DESKTOP_STRIP_NO_SANDBOX=true

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
