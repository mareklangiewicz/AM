ns_url":"https://api.github.com/users/snjlee58/subscriptions","organizations_url":"https://api.github.com/users/snjlee58/orgs","repos_url":"https://api.github.com/users/snjlee58/repos","events_url":"https://api.github.com/users/snjlee58/events{/privacy}","received_events_url":"https://api.github.com/users/snjlee58/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/x-msdownload","state":"uploaded","size":89566867,"digest":"sha256:e01f45015dca8d0fadbecaca0cbdd051b960ab935b583cd737aa76efaa1e0326","download_count":71,"created_at":"2025-07-14T10:28:14Z","updated_at":"2025-07-14T10:28:23Z","browser_download_url":"https://github.com/steineggerlab/Metabuli-App/releases/download/v1.1.1/Metabuli.App-1.1.1-Windows-x64.exe"}],"tarball_url":"https://api.github.com/repos/steineggerlab/Metabuli-App/tarball/v1.1.1","zipball_url":"https://api.github.com/repos/steineggerlab/Metabuli-App/zipball/v1.1.1","body":"- **Added** `Raw-read Quality Control (QC)` **functionality** via [fastp](https://github.com/OpenGene/fastp)/[fastplong](https://github.com/OpenGene/fastplong).\r\n  - Can be run from a separate **“Quality Control”** page or from the **“Taxonomic classification”** page as part of the classification process.\r\n- **Multi-sample support:** Users can now upload multiple samples for sequential classification or preprocessing. Click the \"Add Entry\" button to add additional sample sets.\r\n- **User manuals** have been added to each page for easier reference and guidance on how to use each feature.\r\n- **Sankey plot improvements:** Now powered by the latest version of [TaxoView](https://github.com/steineggerlab/taxoview), which supports extensive customization and improved interactivity:\r\n  - Customization changes are applied instantly—no need to click “Apply.”\r\n  - New visual settings: adjust node label width, padding, font size, and x-axis rank label size.\r\n  - Users can select which taxonomic ranks to display.\r\n  - Node colors are now grouped by `domain`, with gradient shading to clarify taxonomic hierarchy.\r\n  - Users can choose from a selection of color schemes in the customization settings.\r\n- **BibTeX citations for Metabuli**, and for **fastp** when QC is enabled, are now generated automatically upon successful job completion along with the classification results."},{"url":"https://api.github.com/repos/steineggerlab/Metabuli-App/releases/231323597","assets_url":"https://api.github.com/repos/steineggerlab/Metabuli-App/releases/231323597/assets","upload_url":"https://uploads.github.com/repos/steineggerlab/Metabuli-App/releases/231323597/assets{?name,label}","html_url":"https://github.com/steineggerlab/Metabuli-App/releases/tag/v1.1.0","id":231323597,"author":{"login":"snjlee58","id":56073141,"node_id":"MDQ6VXNlcjU2MDczMTQx","avatar_url":"https://avatars.githubusercontent.com/u/56073141?v=4","gravatar_id":"","url":"https://api.github.com/users/snjlee58","html_url":"https://github.com/snjlee58","followers_url":"https://api.github.com/users/snjlee58/followers","following_url":"https://api.github.com/users/snjlee58/following{/other_user}","gists_url":"https://api.github.com/users/snjlee58/gists{/gist_id}","starred_url":"https://api.github.com/users/snjlee58/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/snjlee58/subscriptions","organizations_url":"https://api.github.com/users/snjlee58/orgs","repos_url":"https://api.github.com/users/snjlee58/repos","events_url":"https://api.github.com/users/snjlee58/events{/privacy}","received_events_url":"https://api.github.com/users/snjlee58/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOMWaDh84NybfN","tag_name":"v1.1.0","target_commitish":"main","name":"Metabuli App v1.1.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2025-07-10T04:02:22Z","updated_at":"2025-07-10T04:11:05Z","published_at":"2025-07-10T04:11:05Z","assets":[{"url":"https://api.github