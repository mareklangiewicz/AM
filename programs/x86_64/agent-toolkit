#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
# AM-RECIPE-DECLARATION 1
set -eu
APP=agent-toolkit
CATALOG_FORMAT=3
CATALOG_RECIPE=x86_64/agent-toolkit
CATALOG_ALIAS=https://api.github.com/repos/ulises-jeremias/agent-toolkit/releases
CATALOG_REPOSITORY_ID=1322501176
CATALOG_REPOSITORY=ulises-jeremias/agent-toolkit
CATALOG_CHANNEL=any
CATALOG_ASSET_PATTERN='^agent-toolkit-desktop-[0-9]+([.][0-9]+)*-linux-x86_64[.]AppImage$'
PACKAGE_KIND=appimage
PACKAGE_LAYOUT=raw
DESKTOP_EXEC=command
DESKTOP_STRIP_NO_SANDBOX=true

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
