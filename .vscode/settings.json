{
  "yaml.schemas": {
    "./schemas/catalog.schema.yaml#/$defs/apps": [
      "catalog/apps.yaml",
      "tools/catalog-contract/examples/apps.yaml"
    ],
    "./schemas/catalog.schema.yaml#/$defs/repository": [
      "catalog/repositories/*.yaml",
      "tools/catalog-contract/examples/repository*.yaml"
    ],
    "./schemas/catalog.schema.yaml#/$defs/runs": [
      "catalog/status/runs.yaml",
      "tools/catalog-contract/examples/runs*.yaml"
    ],
    "./schemas/catalog.schema.yaml#/$defs/statistics": [
      "catalog/status/statistics.yaml",
      "tools/catalog-contract/examples/statistics.yaml"
    ]
  }
}
