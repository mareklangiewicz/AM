#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
# AM-RECIPE-DECLARATION 1
set -eu
APP=agaric
CATALOG_FORMAT=2
CATALOG_RECIPE=x86_64/agaric
CATALOG_ALIAS=https://api.github.com/repos/jfolcini/agaric/releases
CATALOG_REPOSITORY_ID=1220744390
CATALOG_REPOSITORY=jfolcini/agaric
CATALOG_CHANNEL=any
CATALOG_ASSET_PATTERN='^Agaric_[0-9]+([.][0-9]+)*_amd64[.]AppImage$'
