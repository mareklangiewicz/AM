#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
# AM-RECIPE-DECLARATION 1
set -eu
APP=6502-emulator
CATALOG_FORMAT=2
CATALOG_RECIPE=x86_64/6502-emulator
CATALOG_ALIAS=https://api.github.com/repos/acwright/6502-emulator/releases
CATALOG_REPOSITORY_ID=1166443294
CATALOG_REPOSITORY=acwright/6502-EMULATOR
CATALOG_CHANNEL=any
CATALOG_ASSET_PATTERN='^ac6502-emulator-[0-9]+([.][0-9]+)*-linux-x86_64[.]AppImage$'
PACKAGE_KIND=appimage
PACKAGE_LAYOUT=raw
DESKTOP_EXEC=command
DESKTOP_STRIP_NO_SANDBOX=true

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
