#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=lapce
CATALOG_FORMAT=2
CATALOG_RECIPE="x86_64/lapce"
CATALOG_ALIAS="https://api.github.com/repos/Portable-Linux-Apps/lapce-AppImage/releases"

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*x86_64.*mage$" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
