#!/bin/sh
# AM-CATALOG-RECIPE 1
CATALOG_FORMAT=3
AMREPO=${AMREPO-}
export AMREPO
if [ -z "${AM_CATALOG_SESSION-}" ]; then
    AM_CATALOG_SESSION=$(mktemp -d) || exit 1
    export AM_CATALOG_SESSION
    trap 'rm -rf -- "$AM_CATALOG_SESSION"' 0
    trap 'exit 1' HUP INT TERM
fi

# AM INSTALL SCRIPT VERSION 3.5
set -u
APP=obs-studio
SITE1="pkgforge-dev/OBS-Studio-AppImage" SITE2="ivan-hc/OBS-Studio-appimage"
#VARIANT1="Anylinux" VARIANT2="Full (JuNest)" VARIANT3="Lite (JuNest)"

# CREATE DIRECTORIES AND ADD REMOVER
[ -n "$APP" ] && mkdir -p "/opt/$APP/tmp" "/opt/$APP/icons" && cd "/opt/$APP/tmp" || exit 1
printf "#!/bin/sh\nset -e\nrm -f /usr/local/bin/$APP\nrm -R -f /opt/$APP" > ../remove
printf '\n%s' "rm -f /usr/local/share/applications/$APP-AM.desktop" >> ../remove
chmod a+x ../remove || exit 1

# DOWNLOAD AND PREPARE THE APP, $version is also used for updates
read -r -p "
 Choose which version of OBS Studio AppImage to use:

 1. OBS Studio AppImage built with all dependencies, makes it able to work
    on any linux system, even musl ones.

    Source: https://github.com/pkgforge-dev/OBS-Studio-AppImage

 2. OBS Studio Archimage \"full\", with libcef and browser support.

    Source: https://github.com/ivan-hc/OBS-Studio-appimage

 3. OBS Studio Archimage \"lite\", without libcef or browser support.

    Source: https://github.com/ivan-hc/OBS-Studio-appimage

 Which version you choose (type a number and press ENTER)?" response
RELEASE=""
if echo "$response" | grep -q "^1"; then
	RELEASE="$SITE1"
	ARCHIMAGE_ON=""
	obs_build=".*"
elif echo "$response" | grep -q "^2\|^3"; then
	RELEASE="$SITE2"
	ARCHIMAGE_ON="1"
	if echo "$response" | grep -q "^2"; then
		obs_build="full"
	else
		obs_build="lite"
	fi
fi
[ -z "$RELEASE" ] && exit 0

if [ -z "$ARCHIMAGE_ON" ]; then
version=$(sh "/opt/am/modules/catalog-yaml.am" x86_64/obs-studio --url --source-repository "$RELEASE" --url-filter i "$obs_build" "$@") || exit 1
else
version=$(sh "/opt/am/modules/catalog-yaml.am" x86_64/obs-studio --url --source-repository "$RELEASE" --url-filter i "$obs_build" "$@") || exit 1
fi

if [ -z "$version" ]; then
	printf "\n 💀 ERROR: it seems that upstream removed %b, please retry\n" "$RELEASE" && exit 1
else
	wget "$version" || exit 1
fi
cd ..
mv ./tmp/*mage ./"$APP"
# Keep this space in sync with other installation scripts
rm -R -f ./tmp || exit 1
echo "$version" > ./version
chmod a+x ./"$APP" || exit 1

# LINK TO PATH
ln -s "/opt/$APP/$APP" "/usr/local/bin/$APP"

# SCRIPT TO UPDATE THE PROGRAM
cat >> ./AM-updater << 'EOF'
#!/bin/sh
# AM-CATALOG-RECIPE 1
CATALOG_FORMAT=3
AMREPO=${AMREPO-}
export AMREPO
if [ -z "${AM_CATALOG_SESSION-}" ]; then
    AM_CATALOG_SESSION=$(mktemp -d) || exit 1
    export AM_CATALOG_SESSION
    trap 'rm -rf -- "$AM_CATALOG_SESSION"' 0
    trap 'exit 1' HUP INT TERM
fi
set -u
APP=obs-studio
SITE="REPLACETHIS"
version0=$(cat "/opt/$APP/version")
version=$(sh "/opt/am/modules/catalog-yaml.am" x86_64/obs-studio --url --source-repository "$SITE" --url-filter i "AM_OBS_BUILD" "$@") || exit 1
[ -n "$version" ] || { echo "Error getting link"; exit 1; }
if [ "$version" != "$version0" ]; then
	mkdir "/opt/$APP/tmp" && cd "/opt/$APP/tmp" || exit 1
	notify-send "A new version of $APP is available, please wait"
	wget "$version" || exit 1
	# Use tar fx ./*tar* here for example in this line in case a compressed file is downloaded.
	cd ..
	mv --backup=t ./tmp/*mage ./"$APP"
	chmod a+x ./"$APP" || exit 1
	echo "$version" > ./version
	rm -R -f ./*zs-old ./*.part ./tmp ./*~
	notify-send "$APP is updated!"
else
	echo "Update not needed!"
fi
EOF
chmod a+x ./AM-updater || exit 1
sed -i "s#REPLACETHIS#$RELEASE#g" /opt/"$APP"/AM-updater
sed -i "s#AM_OBS_BUILD#$obs_build#g" /opt/"$APP"/AM-updater

# LAUNCHER & ICON
./"$APP" --appimage-extract *.desktop 1>/dev/null && mv ./squashfs-root/*.desktop ./"$APP".desktop
./"$APP" --appimage-extract .DirIcon 1>/dev/null && mv ./squashfs-root/.DirIcon ./DirIcon
COUNT=0
while [ "$COUNT" -lt 10 ]; do # Tries to get the actual icon/desktop if it is a symlink to another symlink
	if [ -L ./"$APP".desktop ]; then
		LINKPATH="$(readlink ./"$APP".desktop | sed 's|^\./||' 2>/dev/null)"
		./"$APP" --appimage-extract "$LINKPATH" 1>/dev/null && mv ./squashfs-root/"$LINKPATH" ./"$APP".desktop
	fi
	if [ -L ./DirIcon ]; then
		LINKPATH="$(readlink ./DirIcon | sed 's|^\./||' 2>/dev/null)"
		./"$APP" --appimage-extract "$LINKPATH" 1>/dev/null && mv ./squashfs-root/"$LINKPATH" ./DirIcon
	fi
	[ ! -L ./"$APP".desktop ] && [ ! -L ./DirIcon ] && break
	COUNT=$((COUNT + 1))
done
sed -i "s#Exec=[^ ]*#Exec=$APP#g; s#Icon=.*#Icon=/opt/$APP/icons/$APP#g" ./"$APP".desktop
mv ./"$APP".desktop /usr/local/share/applications/"$APP"-AM.desktop && mv ./DirIcon ./icons/"$APP" 1>/dev/null
rm -R -f ./squashfs-root
