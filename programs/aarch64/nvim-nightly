#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=nvim-nightly
CATALOG_ALIAS="https://api.github.com/repos/neovim/neovim/releases"
# Nightly assets change in place at the same URL.
REFRESH_ALWAYS=true
ASSET_URL='https.*releases.*nvim.*mage$'
ASSET_EXCLUDE="x86_64\|i686\|i386"
ASSET_INCLUDE=nightly

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
