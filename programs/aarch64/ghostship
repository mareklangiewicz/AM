#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=ghostship
CATALOG_ALIAS="https://api.github.com/repos/pkgforge-dev/Ghostship-AppImage-Enhanced/releases"

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*mage$" | grep -i "aarch64" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
