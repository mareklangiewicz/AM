set -eu
APP=accshift
CATALOG_FORMAT=2
CATALOG_RECIPE=x86_64/accshift
CATALOG_ALIAS=https://api.github.com/repos/klnuno/accshift/releases
CATALOG_REPOSITORY_ID=1140627160
