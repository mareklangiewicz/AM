#!/bin/sh
# AMCLI shared YAML-only installer. Recipes are trusted code; catalogs are inert facts.
am_appimage() { am_package "$@"; }

am_archive_configure() {
	archive_kind=$1 archive_root=. archive_executables=$2 archive_launchers="$2:$2" archive_legacy_launchers="$2:bin/$2" tools=
	case $1 in raw|tar) return 0 ;; esac
	policy=${AM_ARCHIVE_POLICY-$(dirname -- "${CATALOG_YAML_HELPER-/opt/am/modules/catalog-yaml.am}")/archive-policy.am}
	[ -r "$policy" ] || { echo 'Missing archive-policy.am; synchronize AM modules.' >&2; return 1; }
	. "$policy"
	am_archive_policy "$1" "$2"
}

am_archive_stage() (
	set -eu
	layout=$1 stage=$2 app=$3
	am_archive_configure "$layout" "$app" || exit 1
	mkdir "$stage/unpacked" "$stage/payload" || exit 1
	check_names() {
		awk 'BEGIN { bad=0 } /^\// || /(^|\/)\.\.(\/|$)/ || /\\/ { bad=1 } END { exit bad }'
	}
	untar() {
		tar -tf "$1" > "$stage/members" || return 1
		check_names < "$stage/members" || return 1
		tar --no-same-owner --no-same-permissions -xf "$1" -C "$2"
	}
	case $archive_kind in
		toolset)
			for tool in $tools; do
				mkdir "$stage/unpacked/$tool" || exit 1
				untar "$stage/$tool.tar.gz" "$stage/unpacked/$tool" || exit 1
				[ -f "$stage/unpacked/$tool/$tool" ] && [ ! -L "$stage/unpacked/$tool/$tool" ] || exit 1
				cp "$stage/unpacked/$tool/$tool" "$stage/payload/$tool" || exit 1
				chmod a+x "$stage/payload/$tool" || exit 1
			done ;;
		tar|zip)
			if [ "$archive_kind" = zip ]; then
				unzip -Z1 "$stage/asset" > "$stage/members" || exit 1
				check_names < "$stage/members" || exit 1
				unzip -q "$stage/asset" -d "$stage/unpacked" || exit 1
			else
				untar "$stage/asset" "$stage/unpacked" || exit 1
			fi
			# Root globs are trusted adapter data, resolved against extracted paths.
			set -- "$stage/unpacked"/$archive_root
			[ "$#" -eq 1 ] && [ -d "$1" ] && [ ! -L "$1" ] || exit 1
			tree=$1
			for binary in $archive_executables; do
				[ -f "$tree/$binary" ] && [ ! -L "$tree/$binary" ] || exit 1
			done
			cp -a "$tree/." "$stage/payload/" || exit 1
			for binary in $archive_executables; do chmod a+x "$stage/payload/$binary" || exit 1; done ;;
		*) echo 'Unsupported archive kind' >&2; exit 1 ;;
	esac
)

am_package() (
	set -eu
	recipe=$1; shift
	icon_theme=false
	if [ "${1-}" = --am-icons ]; then icon_theme=true; shift; fi
	mode=install
	if [ "${1-}" = --am-update ]; then mode=update; shift; fi
	AMREPO=${AMREPO-}; export AMREPO
	APPS_DIR=${APPS_DIR-/opt}; BIN_DIR=${BIN_DIR-/usr/local/bin}
	DESKTOP_DIR=${DESKTOP_DIR-/usr/local/share/applications}
	PACKAGE_KIND=${PACKAGE_KIND-appimage}; layout=${PACKAGE_LAYOUT-raw}
	# Recipe interface: space-separated extra names for the app executable;
	# desktop Exec chooses the command name (default) or quoted installed path.
	extra_launchers=${EXTRA_APP_LAUNCHERS-}
	case $extra_launchers in *[!a-z0-9.+_\ -]*) echo 'Invalid extra launcher names' >&2; exit 1;; esac
	for extra in $extra_launchers; do
		case $extra in .*|"$APP") echo 'Invalid extra launcher name' >&2; exit 1;; esac
	done
	case ${DESKTOP_EXEC-command} in command|installed) ;; *) echo 'Invalid desktop Exec mode' >&2; exit 1;; esac
	case $APP in ''|.*|*[!a-z0-9.+_-]*) echo 'Invalid app identity' >&2; exit 1;; esac
	case $PACKAGE_KIND in appimage|executable) ;; *) exit 1;; esac
	[ "${CATALOG_FORMAT-1}" = 2 ] || {
		echo 'This fork uses YAML catalogs only; this recipe needs conversion.' >&2; exit 3;
	}
	am_archive_configure "$layout" "$APP" || exit 3
	catalog_recipe=${CATALOG_RECIPE-}
	[ "${catalog_recipe#*/}" = "$APP" ] || exit 3
	CATALOG_YAML_HELPER=${CATALOG_YAML_HELPER-/opt/am/modules/catalog-yaml.am}
	[ -r "$CATALOG_YAML_HELPER" ] || { echo 'Missing catalog-yaml.am; synchronize AM modules.' >&2; exit 3; }
	if [ "${VERSION_IDENTITY-url}" = published_at ]; then
		selection=$(sh "$CATALOG_YAML_HELPER" "$catalog_recipe" --with-published-at "$@") || exit 3
		[ "$(printf '%s\n' "$selection" | wc -l)" -eq 7 ] || exit 3
		version=$(printf '%s\n' "$selection" | sed -n '7p')
	else
		selection=$(sh "$CATALOG_YAML_HELPER" "$catalog_recipe" "$@") || exit 3
		[ "$(printf '%s\n' "$selection" | wc -l)" -eq 6 ] || exit 3
		version=$(printf '%s\n' "$selection" | sed -n '6p')
	fi
	download=$(printf '%s\n' "$selection" | sed -n '6p')
	[ -n "$version" ] && [ -n "$download" ] || exit 3
	if [ -n "$tools" ]; then
		publication=$(printf '%s\n' "$selection" | sed -n '1p')
		release=$(printf '%s\n' "$selection" | sed -n '2,3p')
		tool_urls=$download
		first_tool=true
		for tool in $tools; do
			if [ "$first_tool" = true ]; then first_tool=false; continue; fi
			extra=$(sh "$CATALOG_YAML_HELPER" "$catalog_recipe" --commit "$publication" --tool "$tool") || exit 3
			[ "$(printf '%s\n' "$extra" | wc -l)" -eq 6 ] &&
				[ "$(printf '%s\n' "$extra" | sed -n '2,3p')" = "$release" ] || {
				echo 'Package tools must come from one release.' >&2; exit 3;
			}
			tool_urls=$(printf '%s\n%s' "$tool_urls" "$(printf '%s\n' "$extra" | sed -n '6p')")
		done
	fi
	dir=${APPS_DIR%/}/$APP
	if [ "$mode" = update ] && [ "${REFRESH_ALWAYS-false}" = false ] &&
		[ "$version" = "$(cat "$dir/version")" ] && ! grep -sq '^Checksum failure$' "$dir/AM-VERIFIED"; then
		echo 'Update not needed!'; exit 0
	fi
	mkdir -p "$dir"
	stage=$(mktemp -d "$dir/.am-stage.XXXXXX") || exit 1
	trap 'rm -rf -- "$stage"' 0
	trap 'exit 1' HUP INT TERM
	fetch_asset() {
		if command -v wget >/dev/null 2>&1; then wget -O "$2" "$1"
		else curl --fail -L -o "$2" "$1"; fi
	}
	if [ -n "$tools" ]; then
		i=1
		for tool in $tools; do
			url=$(printf '%s\n' "$tool_urls" | sed -n "${i}p")
			fetch_asset "$url" "$stage/$tool.tar.gz" || exit 1
			i=$((i+1))
		done
	else
		fetch_asset "$download" "$stage/asset" || exit 1
	fi
	if [ "$layout" != raw ]; then
		am_archive_stage "$layout" "$stage" "$APP" || exit 1
		# Interrupted replacement is repaired by reinstalling. Keep app data and
		# supporting paths; never call an old remove script during migration.
		cp -a --remove-destination "$stage/payload/." "$dir/" || exit 1
	else
		[ -s "$stage/asset" ] || exit 1
		chmod a+x "$stage/asset"
		mv -f "$stage/asset" "$dir/$APP" || exit 1
	fi
	printf '%s\n' "$version" > "$dir/version"
	printf '%s\n' "$download" > "$dir/download-url"
	if [ "$mode" = update ]; then exit 0; fi
	mkdir -p "$BIN_DIR"
	quote() { printf "'"; printf '%s' "$1" | sed "s/'/'\\\\''/g"; printf "'"; }
	{
		printf '#!/bin/sh\nset -e\nrm -f '; quote "$BIN_DIR/$APP"
		for extra in $extra_launchers; do
			printf '\nif [ "$(readlink '; quote "$BIN_DIR/$extra"
			printf ')" = '; quote "$dir/$APP"
			printf ' ]; then rm -f '; quote "$BIN_DIR/$extra"; printf '; fi'
		done
		for launcher in $archive_launchers; do
			name=${launcher%%:*}
			[ "$name" = "$APP" ] || { printf '\nrm -f '; quote "$BIN_DIR/$name"; }
		done
		printf '\nrm -rf '; quote "$dir"
		if [ "$PACKAGE_KIND" = appimage ]; then
			printf '\nrm -f '; quote "$DESKTOP_DIR/$APP-AM.desktop"
		fi
		printf '\n'
	} > "$dir/remove"
	if ! [ "$recipe" -ef "$dir/recipe.am" ]; then cp "$recipe" "$dir/recipe.am"; fi
	{
		printf '#!/bin/sh\n# AM-CATALOG-UPDATER 1\nexec sh '
		quote "$dir/recipe.am"; printf ' --am-update "$@"\n'
	} > "$dir/AM-updater"
	chmod a+x "$dir/remove" "$dir/AM-updater"
	link_app() {
		# Optional third argument is the known legacy target of a primary launcher.
		link=$BIN_DIR/$1 target=$2
		if [ -L "$link" ]; then
			old=$(readlink "$link")
			case $old in "$target") return 0 ;;
				"${3-}") rm -f "$link" || return 1 ;;
				*) printf 'Preserving custom launcher: %s\n' "$link"; return 0 ;;
			esac
		elif [ -e "$link" ]; then
			printf 'Preserving custom launcher: %s\n' "$link"; return 0
		fi
		ln -s "$target" "$link"
	}
	for launcher in $archive_launchers; do
		name=${launcher%%:*} entry=${launcher#*:}
		legacy=
		for previous in $archive_legacy_launchers; do
			[ "${previous%%:*}" != "$name" ] || legacy=$dir/${previous#*:}
		done
		link_app "$name" "$dir/$entry" "$legacy"
	done
	for extra in $extra_launchers; do link_app "$extra" "$dir/$APP"; done
	[ "$PACKAGE_KIND" = appimage ] || exit 0
	if [ -e "$DESKTOP_DIR/$APP-AM.desktop" ] || [ -L "$DESKTOP_DIR/$APP-AM.desktop" ]; then
		printf 'Preserving desktop launcher: %s\n' "$DESKTOP_DIR/$APP-AM.desktop"
		exit 0
	fi
	mkdir -p "$DESKTOP_DIR" "$dir/icons"
	cd "$dir"
	# AppImage extraction with the same installed-tool fallback as AM installers.
	extract() {
		if ! ./"$APP" --appimage-extract "$@"; then
			if command -v 7z >/dev/null 2>&1; then 7z x ./"$APP" -o./squashfs-root "$@"
			elif command -v 7zz >/dev/null 2>&1; then 7zz x ./"$APP" -o./squashfs-root "$@"
			else return 1
			fi
		fi
	}
	extract '*.desktop' 1>/dev/null && mv ./squashfs-root/*.desktop ./"$APP".desktop
	extract .DirIcon 1>/dev/null && mv ./squashfs-root/.DirIcon ./DirIcon
	COUNT=0
	while [ "$COUNT" -lt 10 ]; do # Tries to get the actual icon/desktop if it is a symlink to another symlink
		if [ -L ./"$APP".desktop ]; then
			LINKPATH="$(readlink ./"$APP".desktop | sed 's|^\./||' 2>/dev/null)"
			extract "$LINKPATH" 1>/dev/null && mv ./squashfs-root/"$LINKPATH" ./"$APP".desktop
		fi
		if [ -L ./DirIcon ]; then
			LINKPATH="$(readlink ./DirIcon | sed 's|^\./||' 2>/dev/null)"
			extract "$LINKPATH" 1>/dev/null && mv ./squashfs-root/"$LINKPATH" ./DirIcon
		fi
		[ ! -L ./"$APP".desktop ] && [ ! -L ./DirIcon ] && break
		COUNT=$((COUNT + 1))
	done
	icon=$(printf '%s' "$dir/icons/$APP" | sed 's/[\\&#]/\\&/g')
	[ "$icon_theme" = false ] || icon=$APP
	sed -i "s#Exec=[^ ]*#Exec=$APP#g; s#Icon=.*#Icon=$icon#g" ./"$APP".desktop
	if [ "${DESKTOP_EXEC-command}" = installed ]; then
		# Desktop Exec uses its own quoting rules, then sed needs replacement escaping.
		gui=$(printf '%s' "$dir/$APP" | sed 's/[\\"`$]/\\&/g; s/\\/\\\\/g; s/%/%%/g; s/[\\&#]/\\&/g')
		sed -i "s#^Exec=$APP#Exec=\"$gui\"#" ./"$APP".desktop
	fi
	if command -v appimage_desktop >/dev/null 2>&1; then appimage_desktop ./"$APP".desktop; fi
	mv ./"$APP".desktop "$DESKTOP_DIR"/"$APP"-AM.desktop && mv ./DirIcon ./icons/"$APP" 1>/dev/null
	rm -R -f ./squashfs-root
)
