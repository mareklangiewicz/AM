thub.com/users/XMuli/events{/privacy}","received_events_url":"https://api.github.com/users/XMuli/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/x-zip-compressed","state":"uploaded","size":149414565,"digest":null,"download_count":47,"created_at":"2025-01-06T14:08:36Z","updated_at":"2025-01-06T14:09:31Z","browser_download_url":"https://github.com/XMuli/SunnyPages/releases/download/v3.1/SunnyCapturer_protable_3.1.0_x64_offline_ocr_cpu.zip"},{"url":"https://api.github.com/repos/XMuli/SunnyPages/releases/assets/218378725","id":218378725,"node_id":"RA_kwDONhxclc4NBDHl","name":"SunnyCapturer_setup_3.1.0_x64_offline_ocr_cpu.exe","label":null,"uploader":{"login":"XMuli","id":33887845,"node_id":"MDQ6VXNlcjMzODg3ODQ1","avatar_url":"https://avatars.githubusercontent.com/u/33887845?v=4","gravatar_id":"","url":"https://api.github.com/users/XMuli","html_url":"https://github.com/XMuli","followers_url":"https://api.github.com/users/XMuli/followers","following_url":"https://api.github.com/users/XMuli/following{/other_user}","gists_url":"https://api.github.com/users/XMuli/gists{/gist_id}","starred_url":"https://api.github.com/users/XMuli/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/XMuli/subscriptions","organizations_url":"https://api.github.com/users/XMuli/orgs","repos_url":"https://api.github.com/users/XMuli/repos","events_url":"https://api.github.com/users/XMuli/events{/privacy}","received_events_url":"https://api.github.com/users/XMuli/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/x-msdownload","state":"uploaded","size":105793840,"digest":null,"download_count":48,"created_at":"2025-01-06T14:09:31Z","updated_at":"2025-01-06T14:11:03Z","browser_download_url":"https://github.com/XMuli/SunnyPages/releases/download/v3.1/SunnyCapturer_setup_3.1.0_x64_offline_ocr_cpu.exe"}],"tarball_url":"https://api.github.com/repos/XMuli/SunnyPages/tarball/v3.1","zipball_url":"https://api.github.com/repos/XMuli/SunnyPages/zipball/v3.1","body":"> ### This tag v3.1 is an updated mirror of the transition site, more rich binary versions can be downloaded from [GitHub](https://github.com/XMuli/SunnyCapturer/releases), and will not be updated from the SunnyPages repository.\r\n\r\nNew year, new version upgrade, bring different feeling 🎀; new official website and user manual [https://sunnycapturer.xmuli.tech](https://sunnycapturer.xmuli.tech/)\r\n\r\n**Features:**\r\n\r\n- OCR text extraction, online and offline mode\r\n- Image translation, support 100+ languages\r\n- Customizable stickers\r\n- Pin images to desktop\r\n- Light and dark themes\r\n- New logo activation\r\n\r\n**Version optimization:**\r\n\r\n- Added translation: Japanese\r\n- Fix multi-screen capture exception #64 on Linux.\r\n- Fixed shortcut to repeat last screenshot area #64\r\n- Fixed theme color effect in Tooltop #63\r\n- Optimize runtime detection logic for installers\r\n- Build scripts to automate Win and Linux packaging.\r\n\r\nThanks to internationalized translators @thiagodalsoto for Portugal-Brazil, and @tomsphotoart for German, and @coolvitto for Japanese.\r\nSee [Here](https://sunnycapturer.xmuli.tech/#/acknowledgement) for more acknowledgements\r\n\r\n---\r\n\r\n\r\n> ### 本次 tag v3.1是过渡网站的更新的镜像，更多丰富的二进制版本请于 [GitHub ](https://github.com/XMuli/SunnyCapturer/releases)下载，后续不再 SunnyPages 仓库更新。\r\n\r\n\r\n新的一年，全新版本升级，带来不一样的感觉🎀；新的官网和用户手册 [https://sunnycapturer.xmuli.tech](https://sunnycapturer.xmuli.tech/)\r\n\r\n**特色功能:**\r\n\r\n- OCR 提取文本，在线和离线模式\r\n- 图片翻译，支持 100+ 种语言\r\n- 自定义贴图\r\n- 钉图于桌面\r\n- 浅色和暗色主题\r\n- 启用新的 LOGO\r\n\r\n**版本优化:**\r\n- 新增翻译：日本语\r\n- 修复 Linux 下多屏截图异常 #64\r\n- 修复快捷键重复上次截图区域失效 #64\r\n- 修复 Tooltop 的主题颜色效果 #63\r\n- 优化安装包的运行检测逻辑\r\n- 构建自动打包 Win 和 Linux 的脚本\r\n\r\n感谢国际化翻译 @thiagodalsoto 的葡萄牙-巴西、和  @tomsphotoart 的德语、@coolvitto 的日本语。\r\n更多鸣谢参见 [链接](https://sunnycapturer.xmuli.tech/#/zh-cn/acknowledgement)","mentions_count":3}]