#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=ghostty-glfw
CATALOG_FORMAT=2
CATALOG_RECIPE="x86_64/ghostty-glfw"
CATALOG_ALIAS="https://api.github.com/repos/pkgforge-dev/ghostty-appimage/releases"

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*glfw.*x86_64.*mage$" | grep -vi "main" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
