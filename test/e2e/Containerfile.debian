# Environment only; the checkout is mounted read-only at test time.
FROM debian:stable-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash python3 sudo curl wget \
      ca-certificates coreutils findutils grep sed gawk binutils util-linux \
      bsdextrautils file xz-utils unzip p7zip-full libnotify-bin ncurses-bin \
 && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 1000 e2e \
 && printf 'e2e ALL=(ALL) NOPASSWD: ALL\nDefaults env_keep += "E2E_FIXTURE"\nDefaults secure_path="/src/test/e2e/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"\n' > /etc/sudoers.d/e2e \
 && chmod 0440 /etc/sudoers.d/e2e
ENTRYPOINT ["/bin/bash", "/src/test/e2e/container-test.sh"]
