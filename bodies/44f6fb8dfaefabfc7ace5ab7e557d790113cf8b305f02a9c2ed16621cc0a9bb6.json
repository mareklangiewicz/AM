/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":88414712,"digest":"sha256:5ae962c3db482f3510d92a718e56e38fda5063d842932746d8c2b998a138b668","download_count":0,"created_at":"2026-06-11T04:57:17Z","updated_at":"2026-06-11T04:57:20Z","browser_download_url":"https://github.com/aionyx02/keynova/releases/download/v0.7.0/Keynova_0.7.0_amd64.AppImage"},{"url":"https://api.github.com/repos/aionyx02/keynova/releases/assets/444362340","id":444362340,"node_id":"RA_kwDOSRXojM4afG5k","name":"Keynova_0.7.0_amd64.deb","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":11399642,"digest":"sha256:92d36c90fc7358fa4b369e038fb44823cbccb1432b7582f06231cf0d19ecb2f8","download_count":0,"created_at":"2026-06-11T04:57:16Z","updated_at":"2026-06-11T04:57:17Z","browser_download_url":"https://github.com/aionyx02/keynova/releases/download/v0.7.0/Keynova_0.7.0_amd64.deb"},{"url":"https://api.github.com/repos/aionyx02/keynova/releases/assets/444365318","id":444365318,"node_id":"RA_kwDOSRXojM4afHoG","name":"Keynova_0.7.0_x64-setup.exe","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":6860406,"digest":"sha256:828f2e60abe0e208fd7960bdd338c813c3472ac06a62c5f82c65b6a385d0a68c","download_count":2,"created_at":"2026-06-11T05:01:57Z","updated_at":"2026-06-11T05:01:58Z","browser_download_url":"https://github.com/aionyx02/keynova/releases/download/v0.7.0/Keynova_0.7.0_x64-setup.exe"}],"tarball_url":"https://api.github.com/repos/aionyx02/keynova/tarball/v0.7.0","zipball_url":"https://api.github.com/repos/aionyx02/keynova/zipball/v0.7.0","body":"# Keynova v0.7.0\r\n\r\nThe product is sharper: a sizeable cleanup removes dormant subsystems while the\r\nsearch-first daily path gains useful inline AI, transparent ranking, project\r\nprofiles, and trusted-release groundwork.\r\n\r\n## Highlights\r\n\r\n- **Useful inline AI (copy-only).** `explain`, `summarize`, `fix`, `cmd`, and\r\n  `next` produce stable, source-attributed output from the search box — no chat\r\n  window. Generated commands stay copy-only; nothing runs on your behalf.\r\n- **Transparent, practical ranking.** `suggest_next` now blends frequency,\r\n  workspace affinity, and success rate, so your reliable commands surface first.\r\n- **Workspace command profiles.** The `profile` prefix shows a project's\r\n  signature commands, reliability-weighted, replayable from the keyboard.\r\n- **Proactive next step + stability.** An idle `next` surface offers your likely\r\n  next action; a backend crash-log panic hook feeds the `/diag` report.\r\n- **Trusted-release groundwork.** `/diag` exports a redacted diagnostics bundle;\r\n  a dormant GitHub-Releases updater and a secret-gated signing pipeline are\r\n  scaffolded; corrupt `config.toml` is quarantined instead of silently lost.\r\n- **Secrets in the OS keychain.** API keys move out of plaintext `config.toml`\r\n  into the OS credential store (Windows Credential Manager / macOS Keychain /\r\n  Linux secret-service), with a one-time migration on first run.\r\n- **Supply-chain CI.** Dependabot + CodeQL scanning across npm, Cargo, and GitHub\r\n  Actions.\r\n\r\n## What Changed\r\n\r\n- Hardened all five inline capabilities with source-display contracts and\r\n  risk-tagged, copy-only command handling.\r\n- Added project-scoped command profiles (`profile` prefix) and per-project\r\n  workflow ranking signals (frequency × workspace × success rate).\r\n- Added the idle proactive `next` surface and a process-level crash-log hook\r\n  surfaced through `/diag`.\r\n- Added the redacted `/diag` diagnostics bundle, a dormant in-app updater, the\r\n  secret-gated code-signing pipeline scaffold, and corrupt-config quarantine.\r\n- Moved at-rest secrets to the OS keychain (`keyring`); `config.toml` keeps only\r\n  a reference.\r\n- Added Dependabot + CodeQL workflows; reconciled `docs/security.md` with current\r\n  reality (keychain, tightened CSP).\r\n\r\n## Removed\r\n\r\n- **Legacy ReAct agent runtime, Neovim/LazyVim integration, and mouse-control\r\n  mode** — dormant subsystems cut to focus on the search-first core.\r\n- **Per-workspace pinned commands** — surfaced only behind the `profile` prefix\r\n  and overlapped the automatic ranker; removed before it ever shipped.\r\n\r\n## Fixes\r\n\r\n- **Ctrl+K no longer reopens after closing.** An explicit hide now cancels the\r\n  focus-guard that keeps the launcher open while typing, closing a timing race\r\n  where closing right after a keystroke could re-show the window.\r\n- Restored full-width row layout in the `next` / `profile` result lists.\r\n\r\n## Safety Notes\r\n\r\n- The app remains **unsigned**; the signing pipeline is scaffolded but certs are\r\n  not yet configured (SmartScreen / Gatekeeper will still warn).\r\n- AI-generated commands are **copy-only**; there is no generic shell execution.\r\n- At-rest secrets live in the OS keychain; risky file actions keep their\r\n  preview/confirm gates.\r\n\r\n## Validation\r\n\r\n- `npm run lint`\r\n- `npm run build`\r\n- `npm run test`\r\n- `cargo test --manifest-path src-tauri/Cargo.toml`\r\n- `cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings`\r\n- `npm run docs:refresh`\r\n- `npm run verify`\r\n- `git diff --check`"},{"url":"https://api.github.com/repos/aionyx02/keynova/releases/334948416","assets_url":"https://api.github.com/repos/aionyx02/keynova/releases/334948416/assets","upload_url":"https://uploads.github.com/repos/aionyx02/keynova/releases/334948416/assets{?name,label}","html_url":"https://github.com/aionyx02/keynova/releases/tag/v0.6.0","id":334948416,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=",