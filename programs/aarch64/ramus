#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=ramus
CATALOG_FORMAT=3
CATALOG_RECIPE="aarch64/ramus"
CATALOG_ALIAS="https://api.github.com/repos/1337raspberry/ramus/releases"

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*download.*mage$" |  grep -i "aarch64\|arm64" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
