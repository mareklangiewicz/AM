set -eu
APP=ghostty-glfw
CATALOG_FORMAT=3
CATALOG_RECIPE="x86_64/ghostty-glfw"
CATALOG_ALIAS="https://api.github.com/repos/pkgforge-dev/ghostty-appimage/releases"
CATALOG_APPIMAGE_ENDPOINT=list
CATALOG_REPOSITORY_ID=912943674
CATALOG_CHANNEL=any
CATALOG_URL_RULES='[{"pattern":"https.*glfw.*x86_64.*mage$","ignore_case":true,"exclude":false},{"pattern":"main","ignore_case":true,"exclude":true}]'

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*glfw.*x86_64.*mage$" | grep -vi "main" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
