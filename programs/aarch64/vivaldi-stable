#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=vivaldi-stable
CATALOG_FORMAT=3
CATALOG_RECIPE="aarch64/vivaldi-stable"
CATALOG_ALIAS="https://api.github.com/repos/ivan-hc/Vivaldi-appimage/releases/latest"

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*stable.*aarch64.*mage$" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
