#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=sheepshaver
CATALOG_FORMAT=3
CATALOG_RECIPE="x86_64/sheepshaver"
CATALOG_ALIAS="https://api.github.com/repos/Korkman/macemu-appimage-builder/releases"
CATALOG_APPIMAGE_ENDPOINT=list
CATALOG_REPOSITORY_ID=496695667
CATALOG_CHANNEL=any
CATALOG_URL_RULES='[{"pattern":"https.*mage$","ignore_case":true,"exclude":false},{"pattern":"i386|i686|aarch64|arm64|armv7l","ignore_case":true,"exclude":true},{"pattern":"sheepshaver","ignore_case":true,"exclude":false},{"pattern":"continuous","ignore_case":false,"exclude":true}]'

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*mage$" | grep -vi "i386\|i686\|aarch64\|arm64\|armv7l" | grep -i "sheepshaver" | grep -v "continuous" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
