#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
# AM-RECIPE-DECLARATION 1
set -eu
APP=afsplug
CATALOG_FORMAT=3
CATALOG_RECIPE=x86_64/afsplug
CATALOG_ALIAS=https://api.github.com/repos/zhangxianhe666/afsplug/releases
CATALOG_REPOSITORY_ID=1290784521
CATALOG_REPOSITORY=zhangxianhe666/AFSplug
CATALOG_CHANNEL=any
CATALOG_ASSET_PATTERN='^afs-[0-9]+([.][0-9]+)*-x86_64[.]AppImage$'
PACKAGE_KIND=appimage
PACKAGE_LAYOUT=raw
DESKTOP_EXEC=command
DESKTOP_STRIP_NO_SANDBOX=true

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
