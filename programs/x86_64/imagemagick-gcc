#!/bin/sh
# AM INSTALL SCRIPT VERSION 3.5
# AM-CATALOG-RECIPE 1
set -eu
APP=imagemagick-gcc
CATALOG_FORMAT=3
CATALOG_RECIPE="x86_64/imagemagick-gcc"
CATALOG_ALIAS="https://api.github.com/repos/ImageMagick/ImageMagick/releases"

select_asset() {
	sed 's/[()",{} ]/\n/g' | grep -oi "https.*mage$" | grep -vi "i386\|i686\|aarch64\|arm64\|armv7l" | grep -i "gcc" | head -1
}

# shellcheck source=modules/appimage.am
. "/opt/am/modules/appimage.am"
am_appimage "$0" "$@"
